# Copia este archivo como .env para cambiar la configuración.

# Servidor PostgreSQL propio del proyecto (carpeta .pg/, solo 127.0.0.1)
PG_PUERTO=5433
PG_USUARIO=reclone
PG_BASE=reclone
# Carpeta bin de PostgreSQL; vacío = autodetectar en C:\Program Files\PostgreSQL
PG_BIN=

# Para usar otro servidor (p. ej. uno compartido por el equipo), descomenta:
# DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/reclone
